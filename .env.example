# ============================================================
# Open-Verse Environment Configuration
# Copy this file to .env and fill in your values.
# ============================================================

# --- NETWORK CONFIGURATION ---
PORT=5000
HOST=0.0.0.0
# (Docker only) Host port that maps to the container's port 5000
APP_PORT=5000

# --- DATABASE CONFIGURATION ---
# Set to 'false' for PostgreSQL (recommended for Docker/production)
USE_SQLITE=false

# --- PostgreSQL (Docker Compose) ---
# These are used by the 'db' container and the 'migrate' container (and by 'app' unless DB_APP_PASSWORD is set).
# Replace the placeholder with a random value (the app logs a warning at startup while it is weak):
#   openssl rand -hex 24
# Only letters and digits are safe here (the value is put into a connection URL).
# NOTE: the database password is set when the volume is created the first time. Changing POSTGRES_PASSWORD
# later does not change it — see DEPLOYMENT.md ("Passwörter ändern").
POSTGRES_DB=openverse
POSTGRES_USER=openverse
POSTGRES_PASSWORD=change-me-to-a-strong-password

# (Optional, recommended) Least-privilege database role for the app.
# When set, the 'migrate' service creates/updates the role "openverse_app" with this password and only
# SELECT/INSERT/UPDATE/DELETE rights; the app connects with it, cannot change the schema and never gets
# POSTGRES_PASSWORD. Leave empty to keep the previous behaviour (the app uses POSTGRES_USER).
# Generate with: openssl rand -hex 24  (letters and digits only)
DB_APP_PASSWORD=

# (Optional) Database limits, defaults in brackets:
#   DB_STATEMENT_TIMEOUT_MS            longest query of the app in ms [15000], 0 = unlimited
#   DB_IDLE_IN_TRANSACTION_TIMEOUT_MS  open transaction without activity in ms [30000]
#   DB_CONNECTION_TIMEOUT_MS           wait for a free/new connection in ms [10000]
#   DB_POOL_MAX                        connections of the app [10]
# DB_STATEMENT_TIMEOUT_MS=15000

# (Alternative) Full connection string – set this instead of the above if you
# are connecting to an external database (e.g. Neon, Supabase, RDS).
# When using docker-compose the DATABASE_URL is built automatically from the
# POSTGRES_* variables above, so you can leave this blank.
DATABASE_URL=

# --- SQLite (local development only) ---
# Set USE_SQLITE=true and optionally provide a custom path (default: ./local.db).
# The file is created with mode 0600; a path inside the public uploads/ folder is refused.
# In Docker use /app/data/local.db and mount a volume at /app/data.
# SQLITE_PATH=./data/local.db

# --- SECURITY & AUTH ---
# Required for session signing and for encrypting secret admin settings. Generate a strong random string
# (at least 32 characters; the app logs a warning at startup for placeholder or short values):
#   openssl rand -hex 32
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Changing it logs everybody out and makes stored secret settings (SMTP password) unreadable.
SESSION_SECRET=change-me-to-a-long-random-string
# Which proxies may set X-Forwarded-For / X-Forwarded-Proto (client IP for rate limits and IP bans, HTTPS detection).
#   true   = proxies on loopback / private / link-local addresses (nginx on the host or in the docker network).
#            Clients that connect to the published port directly from the internet cannot fake their address.
#   <n>    = exactly n proxy hops in front of the app (e.g. 1)
#   <list> = comma-separated proxy addresses/subnets, e.g. "10.0.0.5, 172.16.0.0/12"
#   false  = no proxy, use the connection address
# Reverse proxy on a PUBLIC address (another server, a load balancer or CDN that connects from a public IP):
#   'true' does not trust it, so every request would appear to come from the proxy and look like plain HTTP.
#   Set TRUST_PROXY=1 (one proxy hop) or the proxy's address/subnet, e.g. TRUST_PROXY=203.0.113.10 —
#   and make sure the app port is only reachable through that proxy.
TRUST_PROXY=true
# 'true' = the session cookie is always Secure (app only reachable via HTTPS).
# 'false' = Secure whenever the request arrives via HTTPS (directly or through a trusted proxy that sends
#           X-Forwarded-Proto: https), so plain-HTTP access on localhost keeps working.
# With REQUIRE_HTTPS=true behind a proxy, TRUST_PROXY must trust that proxy (see above): otherwise the app
# does not see the HTTPS from X-Forwarded-Proto, sends no session cookie and logins do not stick.
REQUIRE_HTTPS=false
# Extra browser origins that may call the API with the user's cookies (CORS) and open the WebSocket,
# comma-separated, e.g. "https://admin.example.com". The app's own origin is always allowed; leave empty
# when the client is served by this app (the default).
CORS_ORIGINS=

# --- INITIAL OWNER ---
# Creates this owner account on startup (password: at least 12 characters).
# If the username already exists and has this password, it is made owner.
# If it exists with another password, nothing changes unless INITIAL_OWNER_RESET_PASSWORD=true
# (sets this password once to recover access; remove it again afterwards).
# The result is logged: docker compose logs app | grep -i "initial owner"
INITIAL_OWNER_USERNAME=
INITIAL_OWNER_PASSWORD=
INITIAL_OWNER_EMAIL=
INITIAL_OWNER_RESET_PASSWORD=false

# --- AUTO-PUNISHMENT ---
# 'true' = only log what the engine would do, without freezing or banning anyone.
AUTO_PUNISHMENT_DRY_RUN=true
# Comma-separated user IDs that are never punished automatically (e.g. your owner account).
AUTO_PUNISHMENT_WHITELIST=

# --- EXTERNAL SERVICES (optional) ---
# SendGrid API key for email verification
SENDGRID_API_KEY=SG.your-key-here
# Groq API key for AI features
GROQ_API_KEY=gsk_your-key-here
