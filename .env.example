# ============================================================
# Open-Verse Environment Configuration
# Copy this file to .env and fill in your values.
# ============================================================

# --- NETWORK CONFIGURATION ---
PORT=5000
HOST=0.0.0.0
# (Docker only) Host port that maps to the container's port 5000
APP_PORT=5000

# --- DATABASE CONFIGURATION ---
# Set to 'false' for PostgreSQL (recommended for Docker/production)
USE_SQLITE=false

# --- PostgreSQL (Docker Compose) ---
# These are used by both the 'db' container and the 'app' container.
POSTGRES_DB=openverse
POSTGRES_USER=openverse
POSTGRES_PASSWORD=change-me-to-a-strong-password

# (Alternative) Full connection string – set this instead of the above if you
# are connecting to an external database (e.g. Neon, Supabase, RDS).
# When using docker-compose the DATABASE_URL is built automatically from the
# POSTGRES_* variables above, so you can leave this blank.
DATABASE_URL=

# --- SQLite (local development only) ---
# Set USE_SQLITE=true and optionally provide a custom path.
# SQLITE_PATH=/var/lib/open-verse/data.db

# --- SECURITY & AUTH ---
# Required for session encryption. Generate a strong random string:
#   node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
SESSION_SECRET=change-me-to-a-long-random-string
# Which proxies may set X-Forwarded-For / X-Forwarded-Proto (client IP for rate limits and IP bans, HTTPS detection).
#   true   = proxies on loopback / private / link-local addresses (nginx on the host or in the docker network).
#            Clients that connect to the published port directly from the internet cannot fake their address.
#   <n>    = exactly n proxy hops in front of the app (e.g. 1)
#   <list> = comma-separated proxy addresses/subnets, e.g. "10.0.0.5, 172.16.0.0/12"
#   false  = no proxy, use the connection address
TRUST_PROXY=true
# 'true' = the session cookie is always Secure (app only reachable via HTTPS).
# 'false' = Secure whenever the request arrives via HTTPS (directly or through a trusted proxy that sends
#           X-Forwarded-Proto: https), so plain-HTTP access on localhost keeps working.
REQUIRE_HTTPS=false
# Extra browser origins that may call the API with the user's cookies (CORS) and open the WebSocket,
# comma-separated, e.g. "https://admin.example.com". The app's own origin is always allowed; leave empty
# when the client is served by this app (the default).
CORS_ORIGINS=

# --- INITIAL OWNER ---
# Creates this owner account on startup (password: at least 12 characters).
# If the username already exists and has this password, it is made owner.
# If it exists with another password, nothing changes unless INITIAL_OWNER_RESET_PASSWORD=true
# (sets this password once to recover access; remove it again afterwards).
# The result is logged: docker compose logs app | grep -i "initial owner"
INITIAL_OWNER_USERNAME=
INITIAL_OWNER_PASSWORD=
INITIAL_OWNER_EMAIL=
INITIAL_OWNER_RESET_PASSWORD=false

# --- AUTO-PUNISHMENT ---
# 'true' = only log what the engine would do, without freezing or banning anyone.
AUTO_PUNISHMENT_DRY_RUN=true
# Comma-separated user IDs that are never punished automatically (e.g. your owner account).
AUTO_PUNISHMENT_WHITELIST=

# --- EXTERNAL SERVICES (optional) ---
# SendGrid API key for email verification
SENDGRID_API_KEY=SG.your-key-here
# Groq API key for AI features
GROQ_API_KEY=gsk_your-key-here
